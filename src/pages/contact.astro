---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/info';

const addr = business.address;
---

<BaseLayout
  title={`Contact & Location | ${business.name}`}
  description="Find Fragancia Dominican Barbershop — address, hours, phone, and directions. Book your next cut today."
>
  <!-- Page header -->
  <section class="pt-32 lg:pt-40 pb-12 bg-ink-900 text-center px-4">
    <p class="section-label mb-3">Get In Touch</p>
    <h1 class="font-serif text-display-lg lg:text-display-xl font-semibold text-cream-50">Contact & Location</h1>
  </section>

  <section class="section-padding bg-ink-900 pt-4">
    <div class="container-content grid grid-cols-1 lg:grid-cols-2 gap-12">

      <!-- Details -->
      <div>
        <h2 class="font-serif text-display-sm font-semibold text-cream-50 mb-6">Visit the shop</h2>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 flex-shrink-0 mt-1 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            <div class="font-sans text-cream-300/80">
              <p class="text-cream-100 font-medium">Address</p>
              <p>{addr.street}</p>
              <p>{addr.locality}, {addr.region} {addr.postalCode}</p>
              <a href={business.mapLink} target="_blank" rel="noopener noreferrer" class="inline-block mt-1 text-gold-400 hover:text-gold-300 text-sm">Get directions →</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 flex-shrink-0 mt-1 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            <div class="font-sans text-cream-300/80">
              <p class="text-cream-100 font-medium">Phone</p>
              <a href={business.phoneHref} class="hover:text-gold-400 transition-colors">{business.phone}</a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <svg class="w-5 h-5 flex-shrink-0 mt-1 text-gold-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <div class="font-sans text-cream-300/80">
              <p class="text-cream-100 font-medium">Instagram</p>
              <a href={business.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">{business.instagramHandle}</a>
            </div>
          </div>
        </div>

        <!-- Hours -->
        <div class="mt-10">
          <h3 class="font-sans text-xs font-semibold tracking-[0.2em] uppercase text-gold-400 mb-4">Hours</h3>
          <ul class="space-y-2 max-w-xs" role="list">
            {business.hours.map((h) => (
              <li class="flex justify-between gap-4 font-sans text-sm text-cream-300/80">
                <span>{h.day}</span>
                <span class={h.open === 'Closed' ? 'text-pole-red' : 'text-cream-200'}>
                  {h.open === 'Closed' ? 'Closed' : `${h.open} – ${h.close}`}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-10">
          <a href={business.instagram} target="_blank" rel="noopener noreferrer" class="btn-gold">Book on Instagram</a>
        </div>
      </div>

      <!-- Map -->
      <div class="aspect-square lg:aspect-auto lg:min-h-[500px] overflow-hidden border border-ink-600">
        <iframe
          src={business.mapEmbedUrl}
          title="Map to Fragancia Dominican Barbershop"
          class="w-full h-full"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
