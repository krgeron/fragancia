---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, currency } from '../data/services';
import { business } from '../data/info';
---

<BaseLayout
  title={`Services & Pricing | ${business.name}`}
  description="Haircuts, skin fades, beard trims, hot towel shaves, and line-ups at Fragancia Dominican Barbershop. See our full service menu and pricing."
>
  <!-- Page header -->
  <section class="pt-32 lg:pt-40 pb-12 bg-ink-900 text-center px-4">
    <p class="section-label mb-3">Service Menu</p>
    <h1 class="font-serif text-display-lg lg:text-display-xl font-semibold text-cream-50">Services & Pricing</h1>
    <p class="mt-4 font-sans text-cream-300/70 max-w-xl mx-auto text-balance">
      Every service is finished with the precision and care that defines Dominican barbering.
    </p>
  </section>

  <!-- Services list -->
  <section class="section-padding bg-ink-900">
    <div class="container-content max-w-3xl">
      <ul class="divide-y divide-ink-700 border-y border-ink-700">
        {services.map((s) => (
          <li class="flex items-start justify-between gap-6 py-6">
            <div>
              <h2 class="font-serif text-2xl font-semibold text-cream-50">{s.name}</h2>
              <p class="mt-1 font-sans text-sm text-cream-300/70 leading-relaxed max-w-md">{s.description}</p>
              <span class="mt-2 inline-block font-sans text-xs uppercase tracking-wider text-cream-300/50">{s.duration}</span>
            </div>
            <span class="font-serif text-2xl text-gold-400 whitespace-nowrap">{currency}{s.price}</span>
          </li>
        ))}
      </ul>

      <p class="mt-6 font-sans text-xs text-cream-300/50 text-center">
        Prices are subject to change. Cash and card accepted.
      </p>

      <div class="text-center mt-12">
        <a href={business.instagram} target="_blank" rel="noopener noreferrer" class="btn-gold">Book Your Appointment</a>
      </div>
    </div>
  </section>
</BaseLayout>
