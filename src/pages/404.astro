---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/info';
---

<BaseLayout
  title={`Page Not Found | ${business.name}`}
  description="The page you're looking for can't be found."
  noindex={true}
>
  <section class="min-h-[70vh] flex items-center justify-center bg-ink-900 px-4 pt-24">
    <div class="text-center">
      <img
        src="/logo.jpg"
        alt={business.name}
        width="96"
        height="96"
        class="h-24 w-24 rounded-full object-cover ring-1 ring-gold-700/50 mx-auto mb-8"
      />
      <p class="section-label mb-3">Error 404</p>
      <h1 class="font-serif text-display-lg font-semibold text-cream-50">Page not found</h1>
      <p class="mt-4 font-sans text-cream-300/70 max-w-md mx-auto">
        Looks like this one's on the cutting room floor. Let's get you back.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-gold">Back Home</a>
        <a href="/services" class="btn-outline-cream">View Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
