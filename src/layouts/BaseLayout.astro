---
import SEOHead from '../components/seo/SEOHead.astro';
import BarberShopSchema from '../components/seo/BarberShopSchema.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  heroImage?: string;
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  heroImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Fonts — Cormorant Garamond (serif) + Inter (sans-serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link rel="preload" href="/logo.jpg" as="image" />
  {heroImage && (
    <link rel="preload" href={heroImage} as="image" fetchpriority="high" />
  )}

  <SEOHead
    title={title}
    description={description}
    canonicalURL={canonicalURL}
    ogImage={ogImage}
    ogType={ogType}
    noindex={noindex}
  />

  <BarberShopSchema />

  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body class="min-h-screen flex flex-col">
  <Header />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
