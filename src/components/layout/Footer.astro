---
import { footerLinks } from '../../data/navigation';
import { business } from '../../data/info';

const currentYear = new Date().getFullYear();
const addr = business.address;
---

<footer class="bg-ink-800 text-cream-100 border-t border-gold-700/40" aria-label="Site footer">

  <div class="container-content px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-6" aria-label={`${business.name} — Home`}>
          <img
            src="/logo.jpg"
            alt={business.name}
            width="56"
            height="56"
            class="h-14 w-14 rounded-full object-cover ring-1 ring-gold-700/50"
            loading="lazy"
          />
          <span class="flex flex-col leading-none">
            <span class="font-serif text-xl font-semibold text-cream-100">Fragancia</span>
            <span class="font-sans text-[0.6rem] tracking-[0.25em] uppercase text-gold-400">Dominican Barbershop</span>
          </span>
        </a>
        <p class="font-sans text-sm text-cream-300/70 leading-relaxed max-w-xs mb-8">
          {business.tagline}. Walk in for a fresh look, walk out feeling brand new.
        </p>

        <!-- Contact info -->
        <div class="flex flex-col gap-3">
          <a
            href={business.phoneHref}
            class="flex items-center gap-3 font-sans text-sm text-cream-200 hover:text-gold-400 transition-colors"
            aria-label={`Call us at ${business.phone}`}
          >
            <svg class="w-4 h-4 flex-shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            {business.phone}
          </a>

          <a
            href={business.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 font-sans text-sm text-cream-200 hover:text-gold-400 transition-colors"
            aria-label="Message us on Instagram"
          >
            <svg class="w-4 h-4 flex-shrink-0 text-gold-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            {business.instagramHandle}
          </a>

          <div class="flex items-start gap-3 font-sans text-sm text-cream-300/70">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            <span>
              {addr.street}<br />
              {addr.locality}, {addr.region} {addr.postalCode}
            </span>
          </div>
        </div>
      </div>

      <!-- Explore links -->
      <div>
        <h3 class="font-sans text-xs font-semibold tracking-[0.2em] uppercase text-gold-400 mb-6">
          Explore
        </h3>
        <ul class="flex flex-col gap-3" role="list">
          {footerLinks.explore.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-sm text-cream-300/70 hover:text-cream-100 transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Hours -->
      <div>
        <h3 class="font-sans text-xs font-semibold tracking-[0.2em] uppercase text-gold-400 mb-6">
          Hours
        </h3>
        <ul class="flex flex-col gap-2" role="list">
          {business.hours.map((h) => (
            <li class="flex justify-between gap-4 font-sans text-sm text-cream-300/70">
              <span>{h.day}</span>
              <span class={h.open === 'Closed' ? 'text-pole-red' : 'text-cream-200'}>
                {h.open === 'Closed' ? 'Closed' : `${h.open} – ${h.close}`}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-ink-700">
    <div class="container-content px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-xs text-cream-300/50 text-center sm:text-left">
        &copy; {currentYear} {business.name}. All rights reserved.
      </p>
      <p class="font-sans text-xs text-cream-300/40 text-center sm:text-right">
        {addr.locality}, {addr.region}
      </p>
    </div>
  </div>
</footer>
